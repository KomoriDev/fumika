{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "paths": {
      "@/*": ["../../packages/webui/src/*"],
      "vite": ["./node_modules/vite"]
    },
    "types": ["node", "electron", "vite/client"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "forge.config.ts",
    "forge.env.d.ts",
    "vite.*.config.ts",
    "vite.renderer.config.mts"
  ]
}
